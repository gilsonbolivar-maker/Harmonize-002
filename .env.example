# Opcional. Só o servidor (npm start) e as funções Netlify leem estas variáveis.
# O site no GitHub Pages é estático e não usa chave nenhuma.
# Sem GEMINI_API_KEY o assistente responde que a IA não está configurada.
# Não coloque uma chave real neste arquivo.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# URL pública, se o servidor precisar montar um link para si mesmo.
APP_URL=
